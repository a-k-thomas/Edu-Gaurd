# ========== Database ==========
# SQLite (default for development - no setup required)
DATABASE_URL=sqlite:///./dropout_db.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql://dropout_user:dropout_pass@localhost:5432/dropout_db

# ========== JWT ==========
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ========== Redis (optional - only needed for async task queues) ==========
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ========== SMS/WhatsApp (Twilio - optional) ==========
# TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890

# ========== Email (SMTP - optional) ==========
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# ========== Application ==========
DEBUG=True
